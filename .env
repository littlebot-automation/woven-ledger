###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=c6f2a1d9b7e34c8fa50d2e91b3746a8c
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite keeps the replica dependency-free — no DB server needed.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Set in .env.local, beside the keypair it unlocks. Both stay out of git.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> app/api ###
# The one API account the phone signs in with. Generate the hash with
#   php bin/console security:hash-password
# and set it in .env.local, single-quoted: a bcrypt hash is full of `$`, which
# dotenv would otherwise read as variable expansion and silently blank out.
API_PASSWORD_HASH=
###< app/api ###
