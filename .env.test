KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# The tests sign real tokens with the real keypair, so the passphrase has to be
# the one the keys were generated with — set both of these in .env.test.local,
# which git ignores. It needs its own file rather than borrowing .env.local:
# Symfony deliberately skips .env.local when APP_ENV=test.
JWT_PASSPHRASE=
API_PASSWORD_HASH=
