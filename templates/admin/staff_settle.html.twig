{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
  <form method="post" action="{{ action_url }}">
    <div class="form-group mb-3">
      <label class="form-label" for="staff">Staff Member</label>
      <select name="staff" id="staff" class="form-select">
        <option value="">Select</option>
        {% for row in outstanding %}
          <option value="{{ row.staff.id }}"
                  data-count="{{ row.count }}"
                  data-total="{{ row.total|inr }}"
                  {{ selected and selected.id == row.staff.id ? 'selected' : '' }}>
            {{ row.staff.name }} — unpaid {{ row.total|inr }}
          </option>
        {% endfor %}
      </select>
    </div>

    <p id="settle-preview" class="form-help">
      Choose a staff member to see what will be settled.
    </p>

    <div class="form-group mb-3">
      <label class="form-label" for="date">Payment Date</label>
      <input type="date" name="date" id="date" class="form-control" value="{{ today }}">
    </div>

    <div class="form-group mb-3">
      <label class="form-label" for="mode">Mode</label>
      <select name="mode" id="mode" class="form-select">
        {% for label, value in modes %}
          <option value="{{ value }}">{{ label }}</option>
        {% endfor %}
      </select>
    </div>

    <p class="form-help">
      This creates one payment voucher — next number will be
      <strong>{{ next_payment_no }}</strong> — and marks every unpaid
      entry for that staff member as paid against it.
    </p>

    <div class="form-actions">
      <a href="{{ back_url }}" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Generate Payment</button>
    </div>
  </form>

<script>
(function () {
  var select = document.getElementById('staff');
  var preview = document.getElementById('settle-preview');
  if (!select || !preview) return;

  function update() {
    var opt = select.options[select.selectedIndex];
    var count = opt && opt.getAttribute('data-count');
    if (!count) {
      preview.textContent = 'Choose a staff member to see what will be settled.';
      return;
    }
    preview.innerHTML = count + ' unpaid ' + (count === '1' ? 'entry' : 'entries') +
      ' totalling <strong>' + opt.getAttribute('data-total') + '</strong> will be marked paid.';
  }

  select.addEventListener('change', update);
  update();
})();
</script>
{% endblock %}
