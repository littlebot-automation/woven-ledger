{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block page_actions %}
  {% if party %}
    <a class="btn btn-secondary" href="{{ path('admin_ledger_print', {id: party.id}) }}" target="_blank">
      <i class="fa fa-print"></i> Print
    </a>
  {% endif %}
{% endblock %}

{% block main %}
  {% if parties is empty %}
    <div class="alert alert-info">
      Add a customer or supplier first — the ledger builds itself from their transactions.
    </div>
  {% else %}
    <form method="get" action="{{ path('admin_ledger') }}" class="row g-2 align-items-end mb-3">
      <div class="col-auto">
        <label class="form-label" for="party">Party</label>
        <select name="party" id="party" class="form-select" onchange="this.form.submit()">
          {% for p in parties %}
            <option value="{{ p.id }}"{{ party and party.id == p.id ? ' selected' : '' }}>{{ p.name }}</option>
          {% endfor %}
        </select>
      </div>
      <noscript>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Show</button></div>
      </noscript>
    </form>

    {{ include('admin/_ledger_table.html.twig', {ledger: ledger}, with_context: false) }}

    {# The closing balance is the whole account's, not the page's, so it hangs off
       the ledger's total row count rather than the rows currently on screen. #}
    {% if ledger.total > 0 %}
      {% if balance > 0.01 %}
        <div class="alert alert-success mt-3">
          <strong>{{ party.name }}</strong> owes you <strong>{{ balance|inr }}</strong>
        </div>
      {% elseif balance < -0.01 %}
        <div class="alert alert-warning mt-3">
          You owe <strong>{{ party.name }}</strong> <strong>{{ balance|abs|inr }}</strong>
        </div>
      {% else %}
        <div class="alert alert-secondary mt-3">Account settled — nothing outstanding.</div>
      {% endif %}
    {% endif %}
  {% endif %}
{% endblock %}
