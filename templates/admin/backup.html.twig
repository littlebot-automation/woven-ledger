{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
  <h2>Export</h2>
  <p>
    Downloads every record as a single JSON file — settings, plants, parties,
    items with plant-wise stock, staff, work entries, invoices, bills, receipts
    and payments. Keep it somewhere safe.
  </p>

  <table>
    <tbody>
      {% for label, count in counts %}
        <tr><td>{{ label }}</td><td>{{ count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <p><a href="{{ path('admin_backup_export') }}">Download Backup</a></p>

  <h2>Restore</h2>
  <p>
    Restoring <strong>replaces everything</strong> currently in the database.
    This cannot be undone — export first if you are unsure.
  </p>

  <form method="post" action="{{ path('admin_backup_import') }}" enctype="multipart/form-data">
    <p>
      <label for="backup">Backup file (.json)</label>
      <input type="file" name="backup" id="backup" accept="application/json,.json" required>
    </p>

    <p>
      <label>
        <input type="checkbox" name="confirm" value="1">
        I understand this will erase all existing data and replace it.
      </label>
    </p>

    <p><button type="submit">Restore From Backup</button></p>
  </form>
{% endblock %}
