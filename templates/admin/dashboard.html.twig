{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
  <table>
    <tbody>
      <tr><th>Total Sales</th><td>{{ data.totalSales|inr }}</td></tr>
      <tr><th>Total Purchases</th><td>{{ data.totalPurchases|inr }}</td></tr>
      <tr><th>Cash In (Receipts)</th><td>{{ data.cashIn|inr }}</td></tr>
      <tr><th>Cash Out (Payments)</th><td>{{ data.cashOut|inr }}</td></tr>
      <tr><th>Outstanding Receivable</th><td>{{ data.receivableTotal|inr }}</td></tr>
      <tr><th>Outstanding Payable</th><td>{{ data.payableTotal|inr }}</td></tr>
      <tr><th>Unpaid Wages</th><td>{{ data.unpaidWages|inr }}</td></tr>
    </tbody>
  </table>

  <h2>Low Stock</h2>
  {% if data.lowStockRows is empty %}
    <p>Every item is above its threshold.</p>
  {% else %}
    <table>
      <thead><tr><th>Item</th><th>Plant</th><th>On Hand</th><th>Threshold</th></tr></thead>
      <tbody>
        {% for row in data.lowStockRows %}
          <tr>
            <td>{{ row.item.name }}</td>
            <td>{{ row.plant.name }}</td>
            <td>{{ row.qty|qty }} {{ row.item.unit }}</td>
            <td>{{ row.threshold|qty }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  <h2>Top Outstanding Parties</h2>
  {% if data.topOutstanding is empty %}
    <p>No outstanding balances.</p>
  {% else %}
    <table>
      <thead><tr><th>Party</th><th>Type</th><th>Balance</th></tr></thead>
      <tbody>
        {% for row in data.topOutstanding %}
          <tr>
            <td>{{ row.party.name }}</td>
            <td>{{ row.party.typeLabel }}</td>
            <td>{{ row.balance|abs|inr }} {{ row.balance > 0 ? 'to receive' : 'to pay' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  <h2>Recent Sales Invoices</h2>
  {% if data.recentSales is empty %}
    <p>No invoices yet.</p>
  {% else %}
    <table>
      <thead><tr><th>Invoice</th><th>Date</th><th>Buyer</th><th>Total</th></tr></thead>
      <tbody>
        {% for inv in data.recentSales %}
          <tr>
            <td>{{ inv.no }}</td>
            <td>{{ inv.date|date('d M Y') }}</td>
            <td>{{ inv.party ? inv.party.name : '—' }}</td>
            <td>{{ inv.total|inr }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  <h2>Recent Purchase Bills</h2>
  {% if data.recentPurchases is empty %}
    <p>No bills yet.</p>
  {% else %}
    <table>
      <thead><tr><th>Bill</th><th>Date</th><th>Supplier</th><th>Total</th></tr></thead>
      <tbody>
        {% for bill in data.recentPurchases %}
          <tr>
            <td>{{ bill.no }}</td>
            <td>{{ bill.date|date('d M Y') }}</td>
            <td>{{ bill.party ? bill.party.name : '—' }}</td>
            <td>{{ bill.total|inr }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
{% endblock %}
